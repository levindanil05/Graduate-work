msgstr "Документ не найден"

msgid "Upload is not allowed for the current user"
msgstr "Загрузка недоступна для текущего пользователя"

msgid "Filename is not compatible with the document identity"
msgstr "Имя файла не совместимо с идентификатором документа"

msgid "Duplicate version was expected but not found"
msgstr "Ожидалась дублирующая версия, но она не найдена"

