msgstr "Переход «%(from_status)s» → «%(to_status)s» не допускается"

msgid "Comment is required for this transition"
msgstr "Для этого перехода требуется комментарий"

msgid "Version uploaded"
msgstr "Версия загружена"

msgid "Duplicate upload detected; existing version returned"
msgstr "Обнаружена повторная загрузка; возвращена существующая версия"

