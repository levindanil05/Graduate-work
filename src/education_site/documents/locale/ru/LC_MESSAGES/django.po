# documents/services.py — canonical rename
msgid "Canonical rename is only available for study plans"
msgstr "Переименование по канону доступно только для учебных планов"

msgid "User cannot rename this document"
msgstr "Пользователь не может переименовать этот документ"

msgid "Document has no current version"
msgstr "У документа нет текущей версии"

msgid "Proposed name differs too much from the automatic canonical name. Adjust fields or confirm a large deviation."
msgstr "Предлагаемое имя слишком сильно отличается от автоматически вычисленного. Измените поля или подтвердите сильное отклонение."

msgid "Name «%(name)s» is already used by another plan"
msgstr "Имя «%(name)s» уже используется другим планом"

msgid "A file named «%(name)s» already exists in storage"
msgstr "Файл с именем «%(name)s» уже есть в хранилище"

msgid "Source file was not found in storage"
msgstr "Исходный файл не найден в хранилище"

