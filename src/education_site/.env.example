# Скопируйте в корень репозитория как `.env` для docker compose
# или в этот каталог для локального `manage.py runserver`.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,plans.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://plans.example.edu
DJANGO_USE_X_FORWARDED_HOST=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_ADMIN_URL_PATH=admin/
DJANGO_LOG_LEVEL=INFO

# --- База данных (для compose совпадает с POSTGRES_*) ---
DATABASE_URL=postgresql://education_site:change-me@db:5432/education_site
POSTGRES_DB=education_site
POSTGRES_USER=education_site
POSTGRES_PASSWORD=change-me

# --- Файлы и статика ---
USERFILES_ROOT=/app/userfiles
STATIC_ROOT=/app/staticfiles
STATIC_URL=/static/
COLLECT_STATIC_AT_START=1

# --- Хранилище файлов редакций (local | nextcloud) ---
# Инструкция: docs/nextcloud-setup.md
#
# STORAGE_BACKEND — где лежат файлы редакций (основное хранилище).
#   local     — папка USERFILES_ROOT на диске сервера/разработчика (значение по умолчанию).
#               Удобно для разработки без Nextcloud.
#   nextcloud — файлы в Nextcloud по WebDAV; локально остаются только временные файлы
#               (загрузка пользователем, proxy-скачивание, выгрузка на Яндекс.Диск).
# Пример для разработки: local
# Пример для сервера с Nextcloud на той же машине: nextcloud
STORAGE_BACKEND=local

# NEXTCLOUD_URL — базовый адрес Nextcloud без завершающего «/» и без «/remote.php/...».
#   Примеры:
#     https://cloud.example.edu
#     https://example.edu/nextcloud   (если Nextcloud в подкаталоге)
#     http://127.0.0.1:8080          (локальный контейнер Nextcloud)
#     http://nextcloud               (имя сервиса в docker-сети)
# Как узнать: в веб-интерфейсе Файлы → Параметры → поле WebDAV; взять всё до /remote.php.
# Обязателен при STORAGE_BACKEND=nextcloud.
NEXTCLOUD_URL=

# NEXTCLOUD_PUBLIC_URL — адрес, который попадёт в ссылку «Скачать» у пользователя.
#   Пусто (по умолчанию) — используется NEXTCLOUD_URL.
#   Задайте, если программа ходит во внутренний URL, а пользователи открывают публичный HTTPS.
#   Пример: https://cloud.example.edu
NEXTCLOUD_PUBLIC_URL=

# NEXTCLOUD_USER — логин пользователя Nextcloud, под которым пишет программа
#   (именно логин из пути WebDAV, не отображаемое имя).
#   Обязателен при STORAGE_BACKEND=nextcloud.
NEXTCLOUD_USER=

# NEXTCLOUD_APP_PASSWORD — пароль приложения (Параметры → Безопасность → Устройства и сеансы).
#   Не используйте пароль входа в веб-интерфейс: WebDAV его часто отклоняет (401).
#   Обязателен при STORAGE_BACKEND=nextcloud.
NEXTCLOUD_APP_PASSWORD=

# NEXTCLOUD_ROOT — папка внутри файлов этого пользователя, куда кладётся всё хранилище.
#   Без ведущего «/». Папка должна существовать (или будет создана при первой записи, если есть права).
#   По умолчанию: plans
#   Пример: plans   →  /remote.php/dav/files/<user>/plans/documents/...
NEXTCLOUD_ROOT=plans

# NEXTCLOUD_DOWNLOAD_MODE — как пользователь получает файл.
#   direct — в HTML страницы документа прямая ссылка Nextcloud (по умолчанию).
#            Файл при показе страницы НЕ копируется на сервер программы.
#   proxy  — скачивание всегда через программу (поток); прямых ссылок нет.
#            Используйте, если публичные ссылки в Nextcloud запрещены.
NEXTCLOUD_DOWNLOAD_MODE=direct

# NEXTCLOUD_SHARE_TTL_DAYS — срок жизни прямой ссылки в днях (только для mode=direct).
#   Допустимо: целое от 1 до 7. По умолчанию: 7.
#   Не может быть больше максимума, заданного администратором Nextcloud.
NEXTCLOUD_SHARE_TTL_DAYS=7

# NEXTCLOUD_TEMP_DIR — локальная папка для временных файлов
#   (proxy-скачивание, выгрузка на резервное облако, перенос хранилища).
#   Пусто (по умолчанию) — USERFILES_ROOT/.tmp
#   Пример: /app/userfiles/.tmp
NEXTCLOUD_TEMP_DIR=

# NEXTCLOUD_TIMEOUT_SECONDS — тайм-аут одного HTTP-запроса к Nextcloud (секунды).
#   По умолчанию: 30. Увеличьте для больших файлов или медленной сети.
NEXTCLOUD_TIMEOUT_SECONDS=30

# NEXTCLOUD_VERIFY_TLS — проверка TLS-сертификата Nextcloud.
#   true  — проверять (по умолчанию; для рабочего режима).
#   false — не проверять (только для локальной проверки с самоподписанным сертификатом).
#   /path/to/ca.pem — путь к файлу CA внутреннего центра сертификации.
NEXTCLOUD_VERIFY_TLS=true

# --- Корзина и фоновые задачи ---
TRASH_RETENTION_DAYS=30
WORKER_SLEEP_SECONDS=300
SYNC_SCHEDULE_INTERVAL_SECONDS=3600
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_COUNT=14

# --- Брендинг (подписи в интерфейсе) ---
BRANDING_PRODUCT_NAME=Сервис для согласования изменений в учебных планах
BRANDING_PRODUCT_SHORT_NAME=Согласование УП
BRANDING_ORGANIZATION_NAME=Волгоградский государственный технический университет
BRANDING_ORGANIZATION_SHORT_NAME=ВолгГТУ
BRANDING_UNIT_NAME=Учебный отдел
BRANDING_SUPPORT_EMAIL=
APP_VERSION=1.0.0

# --- Яндекс.Диск (см. docs/yandex-disk-howto.md) ---
YANDEX_DISK_UO_READONLY_TOKEN=
YANDEX_DISK_UO_READONLY_BASE_PATH=/shared/uo/plans
YANDEX_DISK_MIKE_RW_TOKEN=
YANDEX_DISK_MIKE_RW_BASE_PATH=/my/plans-copy

# Устаревшие переменные (только dev)
YANDEX_DISK_TOKEN=
YANDEX_DISK_BASE_PATH=/
