# Скопируйте в корень репозитория как `.env` для docker compose
# или в этот каталог для локального `manage.py runserver`.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,plans.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://plans.example.edu
DJANGO_USE_X_FORWARDED_HOST=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_ADMIN_URL_PATH=admin/
DJANGO_LOG_LEVEL=INFO

# --- База данных (для compose совпадает с POSTGRES_*) ---
DATABASE_URL=postgresql://education_site:change-me@db:5432/education_site
POSTGRES_DB=education_site
POSTGRES_USER=education_site
POSTGRES_PASSWORD=change-me

# --- Файлы и статика ---
USERFILES_ROOT=/app/userfiles
STATIC_ROOT=/app/staticfiles
STATIC_URL=/static/
COLLECT_STATIC_AT_START=1

# --- Корзина и фоновые задачи ---
TRASH_RETENTION_DAYS=30
WORKER_SLEEP_SECONDS=300
SYNC_SCHEDULE_INTERVAL_SECONDS=3600
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_COUNT=14

# --- Брендинг (подписи в интерфейсе) ---
BRANDING_PRODUCT_NAME=Сервис для согласования изменений в учебных планах
BRANDING_PRODUCT_SHORT_NAME=Согласование УП
BRANDING_ORGANIZATION_NAME=Волгоградский государственный технический университет
BRANDING_ORGANIZATION_SHORT_NAME=ВолгГТУ
BRANDING_UNIT_NAME=Учебный отдел
BRANDING_SUPPORT_EMAIL=
APP_VERSION=1.0.0

# --- Яндекс.Диск (см. docs/yandex-disk-howto.md) ---
YANDEX_DISK_UO_READONLY_TOKEN=
YANDEX_DISK_UO_READONLY_BASE_PATH=/shared/uo/plans
YANDEX_DISK_MIKE_RW_TOKEN=
YANDEX_DISK_MIKE_RW_BASE_PATH=/my/plans-copy

# Устаревшие переменные (только dev)
YANDEX_DISK_TOKEN=
YANDEX_DISK_BASE_PATH=/
